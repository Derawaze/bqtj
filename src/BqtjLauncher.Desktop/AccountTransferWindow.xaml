<Window x:Class="BqtjLauncher.Desktop.AccountTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账号管理工具" Width="1120" Height="710" MinWidth="940" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextBrush}" Icon="/BqtjLauncher.Desktop;component/Assets/launcher.ico">
    <Window.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PanelBorder}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="8,10" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1C3152" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AccountEditStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="账号管理工具" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18" />
        <!-- 左侧管理已保存记录，右侧导入文本，两栏均能在小窗口内滚动。 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="账号列表" Style="{StaticResource SectionTitleStyle}" />
                    <StackPanel Grid.Row="1" Margin="0,12,0,10">
                        <TextBlock Text="按名称 / 账号搜索" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                        <Grid>
                            <TextBox x:Name="SearchInput" TextChanged="Search_Changed" AutomationProperties.Name="按名称或账号搜索" Padding="10,7,30,7"/>
                            <Path Data="M 11,11 L 16,16 M 12,7 A 5,5 0 1 1 2,7 A 5,5 0 1 1 12,7" Stroke="#9DAABD" StrokeThickness="1.7" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>
                    <DockPanel x:Name="ListActions" Grid.Row="2" Margin="0,0,0,10">
                        <Button x:Name="DeleteButton" DockPanel.Dock="Right" Content="删除所选" Click="Delete_Click"
                                Style="{StaticResource DangerButtonStyle}" IsEnabled="False" Margin="4,0,0,0" />
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="SelectAllInput" Content="全选当前结果"
                                          Foreground="{StaticResource TextBrush}" Checked="SelectAll_Changed" Unchecked="SelectAll_Changed"/>
                                <CheckBox x:Name="ShowPasswordsInput" Content="显示密码" Margin="16,0,0,0"
                                          Foreground="{StaticResource TextBrush}" Checked="ShowPasswords_Changed" Unchecked="ShowPasswords_Changed"/>
                            </StackPanel>
                            <TextBlock x:Name="SelectionSummary" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="Accounts" Grid.Row="3" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                              SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="Accounts_SelectionChanged"
                              BeginningEdit="Accounts_BeginningEdit" CellEditEnding="Accounts_CellEditEnding"
                              PreviewMouseDoubleClick="Accounts_DoubleClick" PreviewMouseRightButtonDown="Accounts_RightClick"
                              Background="{StaticResource PanelBackground}" RowBackground="{StaticResource PanelBackground}"
                              AlternatingRowBackground="#202A39" BorderBrush="{StaticResource PanelBorder}"
                              GridLinesVisibility="None" AutomationProperties.Name="账号列表">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="选" Width="38" IsReadOnly="True" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"
                                                  PreviewMouseLeftButtonDown="RowCheck_MouseDown"
                                                  IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}, Mode=TwoWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- 延迟源更新避免未保存编辑污染快照，由 CellEditEnding 原子提交。 -->
                            <DataGridTextColumn Header="名称" Binding="{Binding DisplayName, UpdateSourceTrigger=Explicit}" SortMemberPath="DisplayName"
                                                Width="*" MinWidth="95" EditingElementStyle="{StaticResource AccountEditStyle}" />
                            <DataGridTextColumn Header="账号" Binding="{Binding Username, UpdateSourceTrigger=Explicit}" SortMemberPath="Username"
                                                Width="*" MinWidth="95" EditingElementStyle="{StaticResource AccountEditStyle}" />
                            <DataGridTextColumn x:Name="PasswordColumn" Visibility="Collapsed" Header="密码" Binding="{Binding Password, UpdateSourceTrigger=Explicit}" SortMemberPath="Password"
                                                Width="*" MinWidth="95" EditingElementStyle="{StaticResource AccountEditStyle}" />
                            <DataGridTemplateColumn Header="有总统" Width="65" IsReadOnly="True" SortMemberPath="HasPresident">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding HasPresident, Mode=OneWay}" Click="President_Click"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  ToolTip="账号所有存档共用；勾选后刷关使用游戏自动拾取和拆解" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="4" Text="双击或右键单元格编辑，Enter 保存，Esc 取消；Ctrl / Shift 多选。"
                               Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="批量导入" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="每行：名称 账号 密码。三项用空格分隔，名称可重复，账号唯一。"
                                   TextWrapping="Wrap" Margin="0,10,0,4" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="例如：名称1 账号1 密码1" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                    <WrapPanel x:Name="Actions" Grid.Row="1" Margin="-4,10,-4,8">
                        <Button Content="读取 TXT" Click="OpenFile_Click" />
                        <Button Content="开始导入" Click="Import_Click" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button x:Name="ReviewButton" Content="审核重复账号" Click="Review_Click" IsEnabled="False" />
                        <Button Content="导出 TXT" Click="Export_Click" />
                        <Button Content="刷新列表" Click="Refresh_Click" />
                    </WrapPanel>
                    <TextBox x:Name="ImportText" Grid.Row="2" AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             AutomationProperties.Name="待导入账号文本" />
                    <TextBlock Grid.Row="3" Text="重复账号先保留原记录，再逐条人工审核；其他有效行继续导入。"
                               Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                </Grid>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="Feedback" TextWrapping="Wrap" MaxHeight="64" />
            <TextBlock Text="密码默认隐藏，勾选“显示密码”后可查看和编辑；导出 TXT 包含明文密码。"
                       Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>
    </Grid>
</Window>
