<Window x:Class="BqtjLauncher.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" Title="爆枪突击启动器" Icon="Assets/launcher.ico" Width="960" Height="620" MinWidth="820" MinHeight="520" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackground}" Foreground="{StaticResource TextBrush}">
  <Grid Margin="32,26,32,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <!-- 标题区只呈现产品身份，不暴露运行时和兼容层等实现细节。 -->
    <Grid Grid.Row="0" Margin="0,0,0,22">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border Width="46" Height="46" Margin="0,0,14,0" Background="{StaticResource PrimaryBrush}" CornerRadius="12">
        <Image Source="Assets/launcher.png" Stretch="Uniform" />
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock FontSize="24" FontWeight="SemiBold" Text="爆枪突击" />
        <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" Text="选择账号，启动游戏" />
      </StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
        <Button Content="打开日志目录" Click="OpenLogs_Click" />
        <Button x:Name="ExportDiagnosticsButton" Content="导出诊断包" Click="ExportDiagnostics_Click" />
        <Button Content="检查更新" AutomationProperties.Name="检查启动器更新" Command="{Binding CheckForUpdatesCommand}" />
      </StackPanel>
    </Grid>
    <!-- 主工作区保持“选择账号 → 执行操作”的稳定阅读顺序。 -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.48*" MinWidth="370" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="0.52*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource CardStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="账号" />
          <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <WrapPanel Grid.Row="0" Margin="-4,0,-4,12">
              <Button Click="AddProfile_Click" Content="新增账号" />
              <Button Click="EditSelected_Click" Content="编辑账号" />
              <Button Click="ManageAccounts_Click" Content="管理账号" />
              <Button Click="DeleteSelected_Click" Content="删除" Style="{StaticResource DangerButtonStyle}" />
            </WrapPanel>
            <ListBox Grid.Row="1" AutomationProperties.Name="账号列表" Background="Transparent" BorderThickness="0" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Margin" Value="0,0,0,6" />
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="BorderThickness" Value="0" />
                  <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Padding="12,10" Background="#141B27" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8">
                          <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#526887" />
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="#1C3152" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="{Binding DisplayName}" />
                      <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="{Binding LastLaunchedDisplay}" />
                    </StackPanel>
                    <Border Grid.Column="1" Margin="10,0,0,0" Padding="7,3" VerticalAlignment="Center" Background="#1D4934" CornerRadius="10" Visibility="{Binding RunningVisibility}">
                      <TextBlock FontSize="11" Foreground="#8CE7AE" Text="运行中" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource CardStyle}">
        <!-- 小窗口允许纵向滚动，避免项目说明挤出可见区域。 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" FontSize="20" FontWeight="SemiBold" Text="{Binding SelectedProfile.DisplayName, TargetNullValue=选择一个账号}" />
            <StackPanel Grid.Row="1" Margin="-4,22,-4,0" Orientation="Horizontal">
              <Button MinWidth="138" Height="44" AutomationProperties.Name="启动游戏" Command="{Binding LaunchProfileCommand}" Content="启动游戏" FontSize="14" FontWeight="SemiBold" Style="{StaticResource PrimaryButtonStyle}" />
              <Button MinWidth="118" Height="44" AutomationProperties.Name="重启游戏" Command="{Binding RestartProfileCommand}" Content="重启游戏" ToolTip="游戏无响应时，关闭并重新启动所选账号的游戏窗口" />
            </StackPanel>
            <Border Grid.Row="2" Margin="0,26,0,0" Padding="16" VerticalAlignment="Top" Background="#141B27" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="当前账号日常" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Content="管理脚本" Click="ManageScripts_Click" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock x:Name="DailyScriptStatus" Text="选择一个账号即可运行其日常。" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <WrapPanel Margin="-4,0,-4,0">
                  <Button x:Name="RunDailyButton" Content="运行日常" Click="RunDaily_Click" IsEnabled="False" MinWidth="110" Style="{StaticResource PrimaryButtonStyle}"/>
                  <Button x:Name="EditDailyButton" Content="编辑日常" Click="EditDaily_Click" IsEnabled="False" MinWidth="100"/>
                </WrapPanel>
                <Separator Background="{StaticResource PanelBorder}" Margin="0,16,0,14"/>
                <Expander Header="其他方案 / 多账号" Foreground="{StaticResource TextBrush}" IsExpanded="False">
                  <StackPanel Margin="0,10,0,0">
                    <ComboBox x:Name="QuickScriptPlans" Margin="0,0,0,10" DisplayMemberPath="ListDisplayName" SelectionChanged="QuickScriptSelection_Changed" ToolTip="选择面板可见的其他方案"/>
                    <Button x:Name="RunScriptButton" Content="运行所选方案" Click="RunScript_Click" IsEnabled="False" HorizontalAlignment="Left"/>
                  </StackPanel>
                </Expander>
                <TextBlock x:Name="ScriptQueueStatus" Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>                <Expander Header="使用提示" Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}">
                  <TextBlock Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}" LineHeight="24" Text="每个账号使用独立游戏窗口，可同时运行多个账号。&#xA;同一账号只会打开一个游戏窗口。&#xA;关闭或重启后需重新登录；刷新保留本次会话。" TextWrapping="Wrap" />
                </Expander>
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>
      </Border>
    </Grid>
    <Border Grid.Row="2" Margin="0,16,0,0" Padding="12,9" Background="#0D121A" BorderBrush="#222D3D" BorderThickness="1" CornerRadius="7">
      <!-- 项目地址独立固定在通知栏右下角，不随主内容滚动，也不挤入状态消息。 -->
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,16,0">
        <TextBlock AutomationProperties.LiveSetting="Polite" Foreground="{StaticResource MutedTextBrush}" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding UpdateStatusText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Foreground="{StaticResource MutedTextBrush}" />
        <TextBlock>
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <DataTrigger Binding="{Binding AvailableRelease}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
          <Hyperlink Click="UpdateLink_Click" Foreground="#8AB8FF">查看更新与下载</Hyperlink>
        </TextBlock>
      </StackPanel>
        <TextBlock x:Name="ProjectLink" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="12"
                   AutomationProperties.Name="项目公开地址" MaxWidth="360" TextWrapping="Wrap" TextAlignment="Right">
          <Run Text="本项目已公开到 GitHub，如果对你有帮助，欢迎点个 Star 支持！" Foreground="{StaticResource MutedTextBrush}"/>
          <LineBreak/>
          <Hyperlink NavigateUri="https://github.com/Derawaze/bqtj" RequestNavigate="ProjectLink_RequestNavigate" Foreground="#8AB8FF">
            <Run Text="https://github.com/Derawaze/bqtj"/>
          </Hyperlink>
        </TextBlock>
      </Grid>
    </Border>
  </Grid>
</Window>
