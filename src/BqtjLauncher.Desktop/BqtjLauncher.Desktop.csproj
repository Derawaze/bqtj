<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BqtjLauncher.Domain\BqtjLauncher.Domain.csproj" />
    <ProjectReference Include="..\BqtjLauncher.Application\BqtjLauncher.Application.csproj" />
    <ProjectReference Include="..\BqtjLauncher.Infrastructure\BqtjLauncher.Infrastructure.csproj" />
    <ProjectReference Include="..\BqtjLauncher.Runtime.Flash\BqtjLauncher.Runtime.Flash.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.1.5</Version>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x86</PlatformTarget>
    <ApplicationIcon>Assets\launcher.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\launcher.ico" />
    <Resource Include="Assets\launcher.png" />
    <!-- 默认脚本作为可编辑文件交付；用户方案只在运行目录生成。 -->
    <Content Include="..\..\resources\scripts\**\*" Link="scripts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
