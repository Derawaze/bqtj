<Window x:Class="BqtjLauncher.Desktop.SaveSlotSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择日常存档" Width="520" Height="480" MinWidth="460" MinHeight="430"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource TextBrush}" Icon="Assets/launcher.ico">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="AccountLabel" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="PlanLabel" Grid.Row="1" Margin="0,8,0,16" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
        <!-- 与游戏一致：左一右二，两列四行；点击卡片后保存，不替用户预选。 -->
        <ItemsControl x:Name="Slots" Grid.Row="2">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" Rows="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
                <Button Click="Select_Click" Tag="{Binding Number}" Margin="4" HorizontalContentAlignment="Left" Padding="14,8">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" MaxWidth="175"/>
                    </StackPanel>
                </Button>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="选择会写入日常操作语句，下次不再询问；之后可在“编辑日常”中修改。" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
            <Button Content="取消" IsCancel="True" HorizontalAlignment="Right" Margin="0,10,0,0" MinWidth="90"/>
        </StackPanel>
    </Grid>
</Window>