<Window x:Class="BqtjLauncher.Desktop.AccountEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑账号" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="账号名称" />
        <TextBox x:Name="DisplayNameInput" MaxLength="40" Margin="0,6,0,16" AutomationProperties.Name="账号名称" />
        <CheckBox x:Name="PresidentInput" Content="有总统（月卡）" Foreground="{StaticResource TextBrush}" Margin="0,0,0,5" />
        <TextBlock Text="账号内所有存档共用。刷材料时由游戏自动拾取、拆解；到期后请取消勾选。"
                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />
        <TextBlock Text="4399账号" />
        <TextBox x:Name="UsernameInput" MaxLength="256" Margin="0,6,0,16" AutomationProperties.Name="4399账号" />
        <TextBlock Text="密码" />
        <Grid Margin="0,6,0,6">
            <PasswordBox x:Name="PasswordInput" MaxLength="1024" Padding="10" Background="#141B27" Foreground="White" AutomationProperties.Name="密码" />
            <TextBox x:Name="VisiblePasswordInput" MaxLength="1024" Visibility="Collapsed" AutomationProperties.Name="可见密码" />
        </Grid>
        <CheckBox x:Name="ShowPasswordInput" Content="显示密码" Foreground="{StaticResource TextBrush}" Checked="ShowPassword_Changed" Unchecked="ShowPassword_Changed" />
        <TextBlock x:Name="PasswordHint" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
        <CheckBox x:Name="ClearInput" Content="清除已保存的4399账号和密码" Foreground="{StaticResource TextBrush}" Margin="0,16,0,12"
                  Checked="ClearInput_Changed" Unchecked="ClearInput_Changed" />
        <TextBlock Text="账号密码将明文保存在本机，下次启动时自动填充并点击登录；验证码或登录失败时请手动处理。"
                   TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
        <TextBlock x:Name="Feedback" Margin="0,12,0,8" TextWrapping="Wrap" Foreground="#FFB5A8" />
        <Button x:Name="BatchToolButton" Content="打开批量管理工具" Click="OpenBatchTool_Click"
                HorizontalAlignment="Left" Margin="0,0,0,12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="保存" Click="Save_Click" IsDefault="True" IsEnabled="False" />
            <Button x:Name="CancelButton" Content="取消" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
